# Postgres (Vercel-Neon integration)
# Prisma v7는 directUrl을 제거하고 단일 URL만 사용 → Vercel의 DATABASE_URL_UNPOOLED 권장
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# NextAuth v5
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Places API (서버 전용 — NEXT_PUBLIC_ 접두어 금지)
GOOGLE_PLACES_API_KEY=""
