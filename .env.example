# Postgres (Vercel-Neon integration)
# Prisma v7는 directUrl을 제거하고 단일 URL만 사용 → Vercel의 DATABASE_URL_UNPOOLED 권장
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v5
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Maps / Places (Step 2 이후 사용)
GOOGLE_MAPS_API_KEY=""
