{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Read(//mnt/c/Users/user/Documents/LogLife/**)",
      "Read(//mnt/c/Users/user/Documents/LogLife/prisma/**)",
      "Read(//tmp/cc-cache/check-harness/**)",
      "Read(//c/tmp/cc-cache/check-harness/**)",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-update-data-source",
      "mcp__context7__resolve-library-id"
    ],
    "additionalDirectories": [
      "C:\\Users\\user\\.claude\\projects\\c--Users-user-Documents-LogLife\\memory",
      "c:\\Users\\user\\Documents\\LogLife",
      "C:\\Users\\user\\.claude\\projects\\c--Users-user-Documents-LogLife"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/log-prompt.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/check-cli-security.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/log-tool.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/stop-test-lint-reminder.ps1"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/cleanup-session-logs.ps1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
